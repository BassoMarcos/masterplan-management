// 6202 led ozram edsed aírutua atelpmoc us ed se ,socram ossab rop odaerc euf aedi/ogidoc/amargorp etse
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esEmpleadoDe(empresaId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/empleados/$(request.auth.uid))
        && get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.empresaId == empresaId
        && get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.estado == "aprobado";
    }
    function esAccesoTotalDe(empresaId) {
      return esEmpleadoDe(empresaId)
        && get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.accesoTotal == true;
    }
    // (2026-09-25) Empresa dueña de un proyecto.
    function empresaDelProyecto(proyectoId) {
      return get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.empresaId;
    }
    // (2026-09-25) Pueden usar los datos DE ADENTRO de un proyecto: el dueño de la empresa,
    // sus empleados aprobados y el SuperAdmin. (Lo que puede ver/editar cada empleado dentro
    // de la app lo siguen controlando sus permisos por área/panel.)
    function puedeUsarProyecto(proyectoId) {
      return request.auth != null && (
        empresaDelProyecto(proyectoId) == request.auth.uid
        || esEmpleadoDe(empresaDelProyecto(proyectoId))
        || request.auth.token.email == "marky.basso98@gmail.com"
      );
    }
    match /empresas/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth.token.email == "marky.basso98@gmail.com";
      allow read: if request.auth != null;
    }
    match /emails_empresa/{email} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /drive_conexiones/{empresaId} {
      allow read, write: if false;
    }
    match /notificaciones/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /notif_leidas/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /proyectos/{proyectoId} {
      allow read, write: if request.auth != null && resource.data.empresaId == request.auth.uid;
      allow read, write: if request.auth.token.email == "marky.basso98@gmail.com";
      allow create: if request.auth != null;
      allow read, write: if esEmpleadoDe(resource.data.empresaId);
    }
    // (2026-09-25) REGLA GENERAL: todo lo que está DENTRO de un proyecto (lotes, secciones de
    // Desarrollos y Obras, y lo que venga: clientes, contratos, cobros, cajas...). Así no hay
    // que tocar las reglas cada vez que se agrega algo nuevo dentro de un proyecto.
    match /proyectos/{proyectoId}/{coleccion}/{resto=**} {
      allow read, write: if puedeUsarProyecto(proyectoId);
    }
    match /preferencias/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /pizarras/{pizarraId} {
      allow read, write: if request.auth != null && pizarraId.split("_")[0] == request.auth.uid;
    }
    // (2026-09-29) EMPLEADOS. Antes cualquiera con cuenta podía crearse un perfil "aprobado" con
    // acceso total en cualquier empresa, o darse permisos solo. Ahora:
    //  - cada uno crea SOLO su propia solicitud, siempre pendiente y sin permisos;
    //  - puede tocar sus datos, pero NO su empresa, estado, permisos, acceso total ni legajo;
    //  - la empresa (y quien tiene acceso total) maneja a sus empleados, pero no puede pasarlos a otra empresa.
    function mismaEmpresa() {
      return request.resource.data.empresaId == resource.data.empresaId;
    }
    match /empleados/{empId} {
      allow create: if request.auth != null && request.auth.uid == empId
        && request.resource.data.estado == "pendiente"
        && request.resource.data.get("accesoTotal", false) == false
        && request.resource.data.get("permisos", {}).size() == 0;
      allow read, delete: if request.auth != null && request.auth.uid == empId;
      allow update: if request.auth != null && request.auth.uid == empId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["empresaId", "estado", "permisos", "accesoTotal", "legajo", "aprobadoEn"]);
      allow read, delete: if request.auth != null && resource.data.empresaId == request.auth.uid;
      allow update: if request.auth != null && resource.data.empresaId == request.auth.uid && mismaEmpresa();
      allow read, delete: if esAccesoTotalDe(resource.data.empresaId);
      allow update: if esAccesoTotalDe(resource.data.empresaId) && mismaEmpresa();
      allow read, write: if request.auth.token.email == "marky.basso98@gmail.com";
    }
    // (2026-09-29) BIBLIOTECA DE DOCUMENTOS: los archivos están en el Drive de cada empresa.
    // La lista y los permisos los maneja SOLO el servidor (funciones "biblioteca" y "bibArchivo"),
    // que revisa quién puede ver qué. Desde la app no se lee ni se escribe directo.
    match /biblioteca_carpetas/{id} {
      allow read, write: if false;
    }
    match /biblioteca_archivos/{id} {
      allow read, write: if false;
    }
    match /biblioteca_raices/{id} {
      allow read, write: if false;
    }
    match /comercial_datos/{docId} {
      allow read, write: if request.auth != null && resource.data.empresaId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.empresaId != null;
      allow read, write: if esEmpleadoDe(resource.data.empresaId);
      allow read, write: if request.auth.token.email == "marky.basso98@gmail.com";
    }
    match /comercial_config/{docId} {
      allow read, write: if request.auth != null && resource.data.empresaId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.empresaId != null;
      allow read, write: if esEmpleadoDe(resource.data.empresaId);
      allow read, write: if request.auth.token.email == "marky.basso98@gmail.com";
    }
  }
}
